@model IEnumerable<Obrasci.Models.Photo>

@{
    ViewData["Title"] = "Search Photos";
}

<h2>Search Photos</h2>

<form asp-action="Search" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label for="hashtag" class="form-label">Hashtag</label>
        <input id="hashtag"
               type="text"
               name="hashtag"
               value="@Html.Encode(ViewBag.Hashtag)"
               class="form-control"
               placeholder="#cat" />
    </div>

    <div class="col-md-2">
        <label for="minSize" class="form-label">Min size (bytes)</label>
        <input id="minSize" type="number" name="minSize" class="form-control" />
    </div>

    <div class="col-md-2">
        <label for="maxSize" class="form-label">Max size (bytes)</label>
        <input id="maxSize" type="number" name="maxSize" class="form-control" />
    </div>

    <div class="col-md-2">
        <label for="from" class="form-label">From</label>
        <input id="from" type="date" name="from" class="form-control" />
    </div>

    <div class="col-md-2">
        <label for="to" class="form-label">To</label>
        <input id="to" type="date" name="to" class="form-control" />
    </div>

    <div class="col-md-3">
        <label for="author" class="form-label">Author</label>
        <input id="author" type="text" name="author" class="form-control" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card">
                <a asp-action="Details" asp-route-id="@item.Id">
                    <img class="card-img-top"
                         src="~/@Html.Encode(item.StoragePath)"
                         alt="@Html.Encode(item.Description)" />
                </a>

                <div class="card-body">
                    <p class="card-text">
                        @Html.Encode(item.Description)
                    </p>

                    <small class="text-muted">
                        by @Html.Encode(item.User?.UserName) on @item.UploadedAt.ToLocalTime()
                    </small>
                </div>
            </div>
        </div>
    }
</div>